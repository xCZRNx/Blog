<div class="max-w-4xl mx-auto py-8">
  <div class="mb-8">
    <.link navigate={~p"/blog"} class="text-blue-500 hover:text-blue-700">← Back to posts</.link>
  </div>

  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <div class="text-gray-700 mb-4"><%= @post.body %></div>
    <div class="flex items-center justify-between text-sm text-gray-500">
      <div>Posted by <%= @post.user.email %></div>
      <div><%= @post.likes_count %> likes</div>
    </div>
  </div>

  <div class="mb-8">
    <h2 class="text-xl font-bold mb-4">Comments</h2>
    <.simple_form for={@comment_form} phx-submit="save-comment" class="mb-6">
      <.input type="textarea" field={@comment_form[:body]} placeholder="Add a comment..." />
      <:actions>
        <.button phx-disable-with="Posting...">Post comment</.button>
      </:actions>
    </.simple_form>

    <div class="space-y-4">
      <%= for comment <- @comments do %>
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="text-gray-700 mb-2"><%= comment.body %></div>
          <div class="text-sm text-gray-500">
            Commented by <%= comment.user.email %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
